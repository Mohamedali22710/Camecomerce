# Copy this file to config/.env and fill in local values.
# Never commit config/.env or real credentials.

# Runtime
NODE_ENV=development
PORT=3007
BASE_URL=http://localhost:3007
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins. Empty = reflect any origin in development,
# deny cross-origin requests in production.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
JSON_BODY_LIMIT=5mb

# MongoDB (required)
# Checkout and stock release use multi-document transactions, so the deployment
# must be a replica set or a sharded cluster (mongos). An Atlas mongodb+srv:// URI
# satisfies this. A standalone mongodb://127.0.0.1:27017 server does NOT support
# transactions and now stops the process at boot. For local development run
# `mongod --replSet rs0` and `rs.initiate()` and use the URI below with
# `?replicaSet=rs0`.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/cctv-ecommerce?retryWrites=true&w=majority

# Redis (optional; required for password-reset tokens)
REDIS_URL=redis://127.0.0.1:6379

# JWT signing secrets (required; each must be at least 32 random characters)
SIGNATURE_ADMIN=replace-with-a-long-random-admin-secret
SIGNATURE_USER=replace-with-a-long-random-user-secret
SIGNATURE_SUPER_ADMIN=replace-with-a-long-random-super-admin-secret
# Used for email-verification, password-reset, and OAuth state tokens.
VERIFY_SIGNATURE_MY=replace-with-a-long-random-verification-secret
ACCESS_TOKEN=30m
REFRESH_TOKEN=30d

# One-time super-admin seed script (npm run seed:admin). Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to true only when you intentionally want to overwrite an existing password.
SEED_ADMIN_RESET_PASSWORD=false

# Password hashing cost (bcrypt rounds, 8-15)
HASH=10

# SMTP (optional; signup verification, password reset, and contact email)
EMAIL=
PASSWORD=
EMAIL_FROM_NAME=CCTV Store
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
CONTACT_RECIPIENT_EMAIL=

# Google OAuth (optional; Google routes return 503 when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image storage: CLOUDINARY or LOCAL
Image_TYPE=LOCAL
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
# Public base URL used for locally stored upload URLs
SERVER=http://localhost:3007

# Store pricing
CURRENCY=SAR
SHIPPING_COST_TYPE=fixed
SHIPPING_COST_VALUE=0

# Payments
# PAYMENT_PROVIDER is authoritative and has no implicit default.
#   paymob -> Paymob only (Egypt or Saudi Arabia, selected by PAYMOB_REGION)
#   mock   -> local development/test only; rejected when NODE_ENV=production
# Production must set this explicitly to paymob. In development it may be left
# unset: the server boots, COD orders work, and card checkout returns 503.
# Stripe was removed on Day 5; there is no rollback adapter.
PAYMENT_PROVIDER=paymob

# Paymob. Optional so COD-only deployments boot; a card attempt without full
# configuration returns 503 and takes no money. Region is explicit:
#   eg  -> https://accept.paymob.com
#   ksa -> https://ksa.paymob.com
# Cross-region endpoints and keys are refused. Test/live is selected by
# PAYMOB_ENV and by the key itself. Never commit real credentials.
PAYMOB_REGION=eg
PAYMOB_ENV=sandbox
PAYMOB_API_KEY=replace-with-paymob-api-key
PAYMOB_SECRET_KEY=replace-with-paymob-secret-key
PAYMOB_PUBLIC_KEY=replace-with-paymob-public-key
PAYMOB_HMAC_SECRET=replace-with-paymob-hmac-secret
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_URL=https://accept.paymob.com/unifiedcheckout/
PAYMOB_INTEGRATION_ID_CARD=replace-with-card-integration-id
PAYMOB_INTEGRATION_ID_MADA=
PAYMOB_INTEGRATION_ID_APPLE_PAY=
PAYMOB_INTEGRATION_ID_TABBY=
PAYMOB_INTEGRATION_ID_TAMARA=

# Only methods confirmed active by the merchant. Apple Pay, Tabby, and Tamara
# must stay absent until the account manager confirms them in writing.
PAYMOB_METHODS_ENABLED=card

# Unpaid card orders release their stock after this many minutes.
PAYMENT_ORDER_TTL_MINUTES=30
