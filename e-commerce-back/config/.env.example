# Copy this file to config/.env and fill in local values.
# Never commit config/.env or real credentials.

# Runtime
NODE_ENV=development
PORT=3007
BASE_URL=http://localhost:3007
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins. Empty = reflect any origin in development,
# deny cross-origin requests in production.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
JSON_BODY_LIMIT=5mb

# MongoDB (required)
MONGODB_URI=mongodb://127.0.0.1:27017/cctv-ecommerce

# Redis (optional; required for password-reset tokens)
REDIS_URL=redis://127.0.0.1:6379

# JWT signing secrets (required; each must be at least 32 random characters)
SIGNATURE_ADMIN=replace-with-a-long-random-admin-secret
SIGNATURE_USER=replace-with-a-long-random-user-secret
SIGNATURE_SUPER_ADMIN=replace-with-a-long-random-super-admin-secret
# Used for email-verification, password-reset, and OAuth state tokens.
VERIFY_SIGNATURE_MY=replace-with-a-long-random-verification-secret
ACCESS_TOKEN=30m
REFRESH_TOKEN=30d

# One-time super-admin seed script (npm run seed:admin). Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to true only when you intentionally want to overwrite an existing password.
SEED_ADMIN_RESET_PASSWORD=false

# Password hashing cost (bcrypt rounds, 8-15)
HASH=10

# SMTP (optional; signup verification, password reset, and contact email)
EMAIL=
PASSWORD=
EMAIL_FROM_NAME=CCTV Store
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
CONTACT_RECIPIENT_EMAIL=

# Google OAuth (optional; Google routes return 503 when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image storage: CLOUDINARY or LOCAL
Image_TYPE=LOCAL
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
# Public base URL used for locally stored upload URLs
SERVER=http://localhost:3007

# Store pricing
CURRENCY=SAR
SHIPPING_COST_TYPE=fixed
SHIPPING_COST_VALUE=0

# Payments
# Active adapter: paymob | mock | stripe (legacy order-path provider).
# mock is development-only and is rejected when NODE_ENV=production.
# The original planning alias PAYMENT_MOCK=true is superseded by PAYMENT_PROVIDER=mock.
PAYMENT_PROVIDER=stripe
Secret_key_Stripe=
STRIPE_WEBHOOK_SECRET=

# Paymob KSA configuration (MVP-12). Read by code (config guard + adapter stub).
# Endpoints and the HMAC field list remain UNCONFIRMED (MVP-13/MVP-15); the
# adapter returns 503 until they are confirmed. Every value must be confirmed in
# writing by the Paymob account manager; see
# docs/implementation/EXTERNAL_INTEGRATION_BLOCKERS.md. Placeholders only.
PAYMOB_ENV=sandbox
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=
PAYMOB_CHECKOUT_URL=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_APPLE_PAY=
PAYMOB_INTEGRATION_ID_TABBY=
PAYMOB_INTEGRATION_ID_TAMARA=
PAYMENT_ORDER_TTL_MINUTES=30
