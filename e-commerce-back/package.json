{
  "name": "e-commerce-back",
  "version": "1.0.0",
  "private": true,
  "description": "CCTV e-commerce backend (TypeScript + Express + MongoDB)",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --watch ./src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/src/index.js",
    "test": "tsx --test src/common/validation/variant.test.ts src/common/utils/buildQuery.test.ts src/module/order/order.pricing.test.ts",
    "test:watch": "tsx --test --watch src/common/validation/variant.test.ts src/common/utils/buildQuery.test.ts src/module/order/order.pricing.test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.11",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "redis": "^6.0.0",
    "stripe": "^22.2.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "cypress": "^15.17.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
